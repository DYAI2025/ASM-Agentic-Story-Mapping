# Copy to .env.local. Never commit real values.

# Which agent structures the context: "fake" (default, no model, no
# credentials), "anthropic", "openai" or "openrouter". An unknown value is an
# error; nothing falls back to another provider.
ASM_AGENT_PROVIDER=fake

# Credentials stay on the server. Only the one for the chosen provider is read.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Model: optional for anthropic (default claude-opus-5-5) and openai (default
# gpt-6-astra), required for openrouter (e.g. vendor/model).
# ASM_AGENT_MODEL=

# Optional: how long one model call may take, 1000..600000 ms (default 120000).
# ASM_AGENT_TIMEOUT_MS=120000

# Optional, openai only: another base URL for an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: work on a different canonical product file. Start over (reset) is
# only allowed on a workspace file named here, never on the repository seed.
# ASM_PRODUCT_FILE=
# ASM_WORK_STATE_FILE=
