# Copy to .env.local. Never commit real values.

# Which agent structures pasted discussions: "fake" (default, no model, no
# credentials) or "anthropic".
ASM_AGENT_PROVIDER=fake

# Only for ASM_AGENT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# ASM_AGENT_MODEL=claude-opus-5-5

# Optional: work on a different canonical product file.
# ASM_PRODUCT_FILE=
